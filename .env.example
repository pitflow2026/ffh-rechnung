# Supabase (Projekt-Einstellungen → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche Adresse der App (für den Anmeldelink), z. B. https://rechnungen.ffh-enterprises.com
NEXT_PUBLIC_APP_URL=

# Microsoft Entra App "FFH Rechnungseingang"
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Yahoo: froese.fitnessstudios@yahoo.com + App-Passwort (nicht das normale Passwort)
YAHOO_IMAP_USER=froese.fitnessstudios@yahoo.com
YAHOO_IMAP_APP_PASSWORD=

# Anthropic (KI-Auslesung der Belege)
ANTHROPIC_API_KEY=
# optional, Standard: claude-sonnet-5-5
ANTHROPIC_MODEL=

# Zufälliger langer Wert, schützt /api/sync (Vercel Cron schickt ihn automatisch mit)
CRON_SECRET=

# Wie viele Tage beim allerersten Abruf rückwirkend geholt werden
INITIAL_SYNC_DAYS=30
